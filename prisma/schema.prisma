// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HabitType {
  BINARY // done / not done
  DURATION // minutes
  COUNT // integer quantity
}

enum HabitPolarity{
  BUILD 
  QUIT
}
enum HabitFrequency{
  DAILY
  WEEKLY
  MONTHLY
  INTERVAL
}
enum TimeOfDay {
  MORNING
  EVENING
}

model User {
  id String @id @default(cuid())
  // These specific fields match what Auth.js's Prism adapter will expect,
  // so we pre-align now and avoid a refactor when we add auth in p2

  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Relation fields: NOT columns - they're how prisma lets you navigate to related rows.
  // One user has mny of each of these. [] means "a list of"
  habits         Habit[]
  journalEntries JournalEntry[]
  planEntries    PlanEntry[]
  accounts Account[]
  sessions Session[]
}

model Habit {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  type                HabitType
  description         String?
  polarity            HabitPolarity @default(BUILD)
  frequency           HabitFrequency @default(DAILY)
  intervalDays        Int?
  startValue          Int?
  incrementValue      Int?
  incrementEveryDays  Int?
  targetValue         Int
  unit                String?
  timeOfDay           TimeOfDay?

  archivedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  logs                HabitLog[]

  @@index([userId])
}

model HabitLog {
  id String @id @default(cuid())

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date       DateTime @db.Date
  value      Int
  reflection String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([habitId, date])
}

model JournalEntry {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime @db.Date
  guidedAnswers Json
  freeText      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

model PlanEntry {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  text      String
  position  Int
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}
model Account {
  id  String @id @default(cuid())
  userId  String
  type  String 
  provider  String
  providerAccountId String
  refresh_token String?
  access_token  String?
  expires_at  Int?
  token_type  String?
  scope String?
  id_token  String?
  session_state String?

  user User @relation(fields: [userId], references: [id],onDelete: Cascade)

  @@unique([provider,providerAccountId])
}

model Session{
  id  String @id @default(cuid())
  sessionToken String @unique
  userId  String
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken{
  identifier String
  token String
  expires DateTime

  @@unique([identifier,token])
}